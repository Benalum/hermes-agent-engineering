{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Task Evaluation",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "project",
    "task_id",
    "task_type",
    "role",
    "model",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "selection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "tests_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tests_passed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reviewer_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "required_rework": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "success"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "merged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
